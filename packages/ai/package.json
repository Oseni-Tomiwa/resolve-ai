{
  "name": "@resolveai/ai",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "pnpm exec eslint src",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "build": "tsc -p ./tsconfig.build.json",
    "test": "jest --config ./jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.18.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@resolveai/eslint-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.2"
  }
}
