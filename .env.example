# ResolveAI environment contract. Keep secrets empty or replace the development placeholders locally.

# Application
NODE_ENV=development
APP_NAME=ResolveAI
API_PORT=4000
WEB_PORT=3000
WORKER_PORT=4100
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT_MS=600000

# URLs and CORS
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WIDGET_SCRIPT_URL=http://localhost:3000/widget.js
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=0
API_BODY_LIMIT=2mb

# PostgreSQL / Prisma
DATABASE_URL=postgresql://resolveai:resolveai@localhost:5432/resolveai?schema=public
# DIRECT_DATABASE_URL=postgresql://resolveai:resolveai@localhost:5432/resolveai?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication. Use distinct random values outside development.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# OpenAI / RAG. The API key is intentionally empty in this template.
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_OUTPUT_TOKENS=800
AI_RETRIEVAL_LIMIT=5
AI_MINIMUM_SCORE=0.4
EMBEDDING_BATCH_SIZE=50

# Storage. Local storage is for development only and is not suitable for multiple production replicas.
STORAGE_PROVIDER=local
KNOWLEDGE_STORAGE_DIR=storage
KNOWLEDGE_MAX_FILE_SIZE_BYTES=10485760
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=resolveai-private-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Billing
BILLING_PROVIDER=mock
# Stripe Dashboard recurring price IDs are required for Pro and Business checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/billing?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/dashboard/billing
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Email
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=ResolveAI
EMAIL_FROM_ADDRESS=no-reply@example.com
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_REPLY_TO=

# Security and rate limits
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60
PUBLIC_RATE_LIMIT_WINDOW_MS=60000

# Observability
LOG_LEVEL=info
# Optional monitoring remains disabled when empty.
# SENTRY_DSN=
# RELEASE=

# Outbound webhooks (required for production webhook secret encryption)
# WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
